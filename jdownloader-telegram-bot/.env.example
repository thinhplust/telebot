# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MyJDownloader Account Credentials
# Register at https://my.jdownloader.org
JD_EMAIL=your_myjdownloader_email@example.com
JD_PASSWORD=your_myjdownloader_password

# Optional: Restrict bot access to specific Telegram user IDs
# Get your chat ID by messaging @userinfobot on Telegram
# Leave empty to allow all users (NOT recommended for public bots)
# Separate multiple IDs with commas
ALLOWED_USERS=123456789,987654321

# Optional: Fshare.vn Account Credentials
# Used for /fshare command to check account balance
FSHARE_EMAIL=your_fshare_email@example.com
FSHARE_PASSWORD=your_fshare_password
# Get your app_key and user_agent from https://www.fshare.vn/developer
FSHARE_APP_KEY=your_fshare_app_key
FSHARE_USER_AGENT=your_app_name

# Optional: Daily summary report time (24h format, e.g. "08:00" for 8 AM)
# Leave empty to disable daily reports
DAILY_REPORT_TIME=08:00

# Optional: Time to check watched Fshare folders for new files (24h format)
# Defaults to DAILY_REPORT_TIME or "06:00" if not set
FOLDER_CHECK_TIME=06:00

# Optional: Maximum file size to download from Fshare folders (in GB)
# Files larger than this will be skipped with a notification
# Default: 30 (30 GB). Set to 0 to disable the limit.
MAX_FILE_SIZE_GB=30
