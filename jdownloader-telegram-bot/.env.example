# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MyJDownloader Account Credentials
# Register at https://my.jdownloader.org
JD_EMAIL=your_myjdownloader_email@example.com
JD_PASSWORD=your_myjdownloader_password

# Optional: Restrict bot access to specific Telegram user IDs
# Get your chat ID by messaging @userinfobot on Telegram
# Leave empty to allow all users (NOT recommended for public bots)
# Separate multiple IDs with commas
ALLOWED_USERS=123456789,987654321
